# Copy to .env for a server that isn't the local default. Every value is optional locally (see nuxt.config.ts).

# Which site this is:
#   client = Dealer Config's dealer website (Laravel dealer-lion-client-templates, :8002)
#   sales  = Dealer CRM's dealer website    (Laravel dealerlion_sales_template, :8003)
NUXT_SITE_TYPE=client

# The client site's dealer (Laravel client site: COMPANY_ID_ENV, COMPANY_INFO).
NUXT_CLIENT_COMPANY_ID=5022
NUXT_CLIENT_COMPANY_NAME=Dealer Lion Demo - Single

# The sales site's dealer (Laravel sales site: COMPANY_ID_ENV, COMPANY_INFO).
NUXT_SALES_COMPANY_ID=5026
NUXT_SALES_COMPANY_NAME=Sales Template Live Demo1

# Optional: serve another dealer whatever the type. Empty = the type's own dealer above.
NUXT_COMPANY_ID=
NUXT_COMPANY_NAME=

# The Dealer Lion API (Laravel: URL_API_CORE).
NUXT_API_BASE=http://localhost:8001

# Where the dealer's media is served from, with a trailing slash (Laravel: MAIN_WEBSITE_URL).
NUXT_MEDIA_BASE=http://localhost:8000/

# Force a template locally (template-1 .. template-4); empty = the dealer's own (Laravel: CURRENT_TEMPLATE).
NUXT_TEMPLATE_OVERRIDE=

# JD Power valuation API for the trade-in form (models, trims, VIN decode). Secret: set it on the server only.
NUXT_JD_API_KEY=
# The UAT or production base URL (Laravel: storedJDApiUrl()).
NUXT_JD_API_URL=https://cloud.jdpower.ai/data-api/valuationservices/valuation

# Google Maps JavaScript key for the credit app's address autocomplete. A browser key: restrict it to the site's domains
# in Google Cloud. Empty = autocomplete off.
NUXT_GOOGLE_MAPS_KEY=
