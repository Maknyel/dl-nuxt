# Copy to .env for a server that isn't the local default. Every value is optional locally (see nuxt.config.ts).

# The Dealer Lion API (Laravel site: URL_API_CORE).
NUXT_API_BASE=http://localhost:8001

# The dealer this site serves (Laravel site: COMPANY_ID_ENV).
NUXT_COMPANY_ID=5022

# The dealer's name as sent to the API (Laravel site: COMPANY_INFO).
NUXT_COMPANY_NAME=Dealer Lion Demo - Single

# Where the dealer's media is served from, with a trailing slash (Laravel site: MAIN_WEBSITE_URL).
NUXT_MEDIA_BASE=http://localhost:8000/

# Force a template locally (template-1 .. template-4); empty = the dealer's own (Laravel site: CURRENT_TEMPLATE).
NUXT_TEMPLATE_OVERRIDE=

# JD Power valuation API for the trade-in form (models, trims, VIN decode). Secret: set it on the server only.
NUXT_JD_API_KEY=
# The UAT or production base URL (Laravel site: storedJDApiUrl()).
NUXT_JD_API_URL=https://cloud.jdpower.ai/data-api/valuationservices/valuation

# Google Maps JavaScript key for the credit app's address autocomplete. A browser key: restrict it to the site's domains
# in Google Cloud. Empty = autocomplete off.
NUXT_GOOGLE_MAPS_KEY=
